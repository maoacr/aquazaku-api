NODE_ENV=development
PORT=3001

# Base ya provisionada localmente (ver /empezar/entorno-local/ en las docs).
DATABASE_URL=postgres://aquazaku:aquazaku@localhost:5432/aquazaku_dev
# Los tests usan SU PROPIA base. Nunca apuntar tests a aquazaku_dev.
DATABASE_URL_TEST=postgres://aquazaku:aquazaku@localhost:5432/aquazaku_test

# Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
COOKIE_DOMAIN=localhost

# Email. En dev sale por Mailpit (SMTP local, UI en http://localhost:8025).
# En prod se usa Resend. El selector es MAIL_TRANSPORT.
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
RESEND_API_KEY=
EMAIL_FROM=noreply@aquazaku.com

# URL pública de web/, para armar los links de los emails.
WEB_PUBLIC_URL=http://localhost:3000

LOG_LEVEL=info
