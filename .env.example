NODE_ENV=development
PORT=3001

# ── Base de datos ────────────────────────────────────────────────────────────
# Dos conexiones a propósito, con roles distintos:
#
#   aquazaku_app  → la que usa el servidor. NO es dueña de las tablas y sobre
#                   audit_log solo tiene SELECT e INSERT. Es lo que hace que la
#                   bitácora sea realmente inmutable para la aplicación.
#   aquazaku      → dueña de las tablas. Solo la usan drizzle-kit y el runner de
#                   migraciones. El servidor nunca se conecta con esta.
#
# Ver /empezar/entorno-local/ para cómo se provisionan.
DATABASE_URL=postgres://aquazaku_app:aquazaku_app@localhost:5432/aquazaku_dev
DATABASE_MIGRATION_URL=postgres://aquazaku:aquazaku@localhost:5432/aquazaku_dev

# Los tests corren contra SU PROPIA base y la truncan. Nunca apuntarlos a _dev.
DATABASE_URL_TEST=postgres://aquazaku_app:aquazaku_app@localhost:5432/aquazaku_test
DATABASE_MIGRATION_URL_TEST=postgres://aquazaku:aquazaku@localhost:5432/aquazaku_test

# ── Auth ─────────────────────────────────────────────────────────────────────
# Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001
COOKIE_DOMAIN=localhost

# ── Email ────────────────────────────────────────────────────────────────────
# En dev sale por Mailpit (UI en http://localhost:8025) y no llega a internet.
# En producción se usa Resend, y ahí RESEND_API_KEY deja de ser opcional.
MAIL_TRANSPORT=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
RESEND_API_KEY=
EMAIL_FROM=noreply@aquazaku.com

# ── Otros ────────────────────────────────────────────────────────────────────
WEB_PUBLIC_URL=http://localhost:3000
LOG_LEVEL=info
