{
  "name": "@aquazaku/api",
  "version": "0.1.0",
  "private": true,
  "description": "API de Aquazaku \u2014 Fastify + Drizzle + Postgres + Better-Auth",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "node --env-file-if-exists=.env node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "tsx --env-file-if-exists=.env drizzle/migrate.ts",
    "db:migrate:test": "tsx --env-file-if-exists=.env drizzle/migrate.ts --test",
    "db:seed": "tsx --env-file-if-exists=.env drizzle/seed.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.3.0",
    "@node-rs/argon2": "^2.1.0",
    "better-auth": "^1.7.1",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.1",
    "nodemailer": "^9.0.5",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "resend": "^6.20.0",
    "tsx": "^4.23.12",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.21.0"
}
