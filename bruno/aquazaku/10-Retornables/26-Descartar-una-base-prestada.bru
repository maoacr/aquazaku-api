meta {
  name: Descartar una base prestada
  type: http
  seq: 26
}

post {
  url: {{baseUrl}}/bases/{{baseId}}/descarte
  body: json
}

body:json {
  {
    "motivo": "Se decidió sacar de servicio el modelo viejo de base"
  }
}

docs {
  El motivo está bien, la base existe, y aún así no.

  Descartarla dejaría un préstamo abierto sobre algo que ya no existe: la
  dirección seguiría figurando con una base que el sistema borró del parque, y
  nadie iría nunca a buscarla. El orden importa — primero se recupera el objeto,
  después se lo saca del inventario.
}

tests {
  test("responde 422", function() {
    expect(res.getStatus()).to.equal(422);
  });

  test("es BASE_PRESTADA", function() {
    expect(res.getBody().code).to.equal("BASE_PRESTADA");
  });

  test("y explica qué quedaría colgado", function() {
    expect(res.getBody().mensaje).to.contain("quedaría un préstamo abierto");
  });
}
