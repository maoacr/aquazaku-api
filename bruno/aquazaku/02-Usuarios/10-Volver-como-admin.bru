meta {
  name: Volver como admin
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/auth/sign-in/email
  body: json
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
  }
}

docs {
  Deja la colección como la encontró. Desde la 8 la sesión era del usuario
  descartable, y sin esto `03-Auditoria` arrancaría con un `pos` y fallaría con
  403 que no tienen nada que ver con la auditoría.
}

tests {
  test("vuelve a ser admin", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
