meta {
  name: Volver como admin
  type: http
  seq: 22
}

post {
  url: {{baseUrl}}/api/auth/sign-in/email
  body: json
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
  }
}

docs {
  Deja la colección como la encontró.

  Sin esto, cualquier request que alguien corra suelto después heredaría la
  sesión del `pos` y fallaría con un 403 que no tiene nada que ver con lo que se
  estaba probando — el peor tipo de test rojo: el que miente sobre la causa.
}

tests {
  test("vuelve a ser admin", function() {
    expect(res.getStatus()).to.equal(200);
  });
