meta {
  name: Desactivar dos veces — 422 CLIENTE_YA_INACTIVO
  type: http
  seq: 41
}

post {
  url: {{baseUrl}}/clientes/{{clienteParaDobleId}}/desactivar
  body: json
}

body:json {
  {
    "motivo": "segundo intento de desactivación de prueba"
  }
}

docs {
  Repetir la desactivación no es idempotente: la primera devolvió
  bases y botellones al stock físico. Una segunda llamada operaría
  sobre saldos que ya no le corresponden al cliente.
}

script:pre-request {
  /*
   * Crea un cliente fresco y lo desactiva, para que la llamada
   * de este test ya encuentre el cliente inactivo. El documento
   * lleva timestamp para correr la colección dos veces seguidas.
   */
  const base = bru.getEnvVar("baseUrl");
  const doc = `79${String(Date.now()).slice(-6)}`;
  bru.setVar("docParaDoble", doc);

  const crear = await bru.sendRequest({
    url: base + "/clientes",
    method: "POST",
    // `sendRequest` no comparte el cookie jar de la colección: sin esta
    // línea sale sin sesión y devuelve 401 (ver el login, 01-Auth/02).
    headers: {
      "content-type": "application/json",
      cookie: bru.getVar("cookieSesion"),
    },
    data: ({
      primerNombre: "Don",
      apellidos: "ParaDoble",
      tipoDocumento: "CC",
      numeroDocumento: doc,
      tipo: "residencial",
    }),
  });
  bru.setVar("clienteParaDobleId", crear.data.id);

  await bru.sendRequest({
    url: base + `/clientes/${crear.data.id}/desactivar`,
    method: "POST",
    // `sendRequest` no comparte el cookie jar de la colección: sin esta
    // línea sale sin sesión y devuelve 401 (ver el login, 01-Auth/02).
    headers: {
      "content-type": "application/json",
      cookie: bru.getVar("cookieSesion"),
    },
    data: ({
      motivo: "primera desactivación para preparar el test 41",
    }),
  });
}

tests {
  test("responde 422", function() {
    expect(res.getStatus()).to.equal(422);
  });

  test("el código de error es CLIENTE_YA_INACTIVO", function() {
    expect(res.getBody().code).to.equal("CLIENTE_YA_INACTIVO");
  });
}
