meta {
  name: Desactivar revierte bases y botellones — flujo completo
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/clientes/{{clienteConStockId}}/desactivar
  body: json
}

body:json {
  {
    "motivo": "se mudó y devuelve sus envases al parque"
  }
}

docs {
  ## Por qué esta petición vive en su propia carpeta, al final

  Su script de preparación COMPRA botellones y da de alta una base: ensucia el
  parque, que es estado global.

  `10-Retornables/01-La-bodega-arranca-vacia` afirma justamente que el parque
  arranca en cero, y `11-Proveedores/05` cuenta los botellones que entraron por
  compra. Corriendo dentro de `08-Clientes` esta preparación les pasaba por
  encima — y las hacía fallar por algo que no tiene nada que ver con lo que
  miran.

  No se notaba porque el script venía roto y moría antes de crear nada. Al
  arreglarlo, el daño apareció.

  Acá corre después de todo lo que necesita un parque limpio, y puede ensuciarlo
  sin arrastrar a nadie.


  El test que importa: verifica que la promesa de RN-CLI-02 se cumple
  cuando hay stock físico de por medio. Un cliente con una base
  prestada y N botellones a su nombre que se desactiva tiene que
  terminar con:

  - `activo = false` en su fila.
  - La base de vuelta en bodega (sin `direccionId`), con una fila
    `tipo='retorno'` en `movimientos_base`.
  - Los botellones drenados de su poder, con una transferencia
    `tipo='retorno'` en `movimientos_botellon` que devuelve los N
    a la bodega.
  - La respuesta trae los dos conteos con los números exactos.
}

script:pre-request {
  /*
   * Crea un cliente con una base prestada y 3 botellones a su
   * nombre, lo desactiva, y devuelve los conteos que deberían
   * venir. La verificación del estado post-desactivación vive
   * en `script:post-response`.
   */
  const base = bru.getEnvVar("baseUrl");
  const doc = `79${String(Date.now()).slice(-6)}`;
  bru.setVar("docConStock", doc);

  // 1. Cliente
  const crear = await bru.sendRequest({
    url: base + "/clientes",
    method: "POST",
    // `sendRequest` no comparte el cookie jar de la colección: sin esta
    // línea sale sin sesión y devuelve 401 (ver el login, 01-Auth/02).
    headers: {
      "content-type": "application/json",
      cookie: bru.getVar("cookieSesion"),
    },
    data: ({
      primerNombre: "Don",
      apellidos: "ConStock",
      tipoDocumento: "CC",
      numeroDocumento: doc,
      tipo: "residencial",
    }),
  });
  const clienteId = crear.data.id;
  bru.setVar("clienteConStockId", clienteId);

  // 2. Verificar (necesario para prestar bases)
  await bru.sendRequest({
    url: base + `/clientes/${clienteId}/verificacion`,
    method: "POST",
    // `sendRequest` no comparte el cookie jar de la colección: sin esta
    // línea sale sin sesión y devuelve 401 (ver el login, 01-Auth/02).
    headers: {
      "content-type": "application/json",
      cookie: bru.getVar("cookieSesion"),
    },
    // Fastify rechaza con 400 un `content-type: application/json` sin cuerpo,
    // y esta ruta no lee ninguno. El objeto vacío es lo que la deja pasar.
    data: ({}),
  });

  // 3. Dirección
  const dir = await bru.sendRequest({
    url: base + `/clientes/${clienteId}/direcciones`,
    method: "POST",
    // `sendRequest` no comparte el cookie jar de la colección: sin esta
    // línea sale sin sesión y devuelve 401 (ver el login, 01-Auth/02).
    headers: {
      "content-type": "application/json",
      cookie: bru.getVar("cookieSesion"),
    },
    data: ({
      etiqueta: "La casa",
      direccion: "Calle 5 #3-20",
    }),
  });
  const direccionId = dir.data.id;

  // 4. Alta de base y préstamo
  const alta = await bru.sendRequest({
    url: base + "/bases",
    method: "POST",
    // `sendRequest` no comparte el cookie jar de la colección: sin esta
    // línea sale sin sesión y devuelve 401 (ver el login, 01-Auth/02).
    headers: {
      "content-type": "application/json",
      cookie: bru.getVar("cookieSesion"),
    },
    data: ({ idSticker: "0051" }),
  });
  await bru.sendRequest({
    url: base + `/bases/${alta.data.id}/prestamo`,
    method: "POST",
    // `sendRequest` no comparte el cookie jar de la colección: sin esta
    // línea sale sin sesión y devuelve 401 (ver el login, 01-Auth/02).
    headers: {
      "content-type": "application/json",
      cookie: bru.getVar("cookieSesion"),
    },
    data: ({ direccionId }),
  });

  // 5. Compra y entrega de botellones (necesita una compra primero
  //    para que la bodega no quede en negativo)
  await bru.sendRequest({
    url: base + "/botellones/compra",
    method: "POST",
    // `sendRequest` no comparte el cookie jar de la colección: sin esta
    // línea sale sin sesión y devuelve 401 (ver el login, 01-Auth/02).
    headers: {
      "content-type": "application/json",
      cookie: bru.getVar("cookieSesion"),
    },
    data: ({
      cantidad: 10,
      motivo: "compra inicial para test de desactivación",
    }),
  });
  await bru.sendRequest({
    url: base + `/botellones/entrega`,
    method: "POST",
    // `sendRequest` no comparte el cookie jar de la colección: sin esta
    // línea sale sin sesión y devuelve 401 (ver el login, 01-Auth/02).
    headers: {
      "content-type": "application/json",
      cookie: bru.getVar("cookieSesion"),
    },
    data: ({
      clienteId,
      cantidad: 3,
    }),
  });
}

tests {
  test("responde 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("devuelve la base prestada al parque", function() {
    expect(res.getBody().basesDevueltas).to.equal(1);
  });

  test("devuelve los 3 botellones a la bodega", function() {
    expect(res.getBody().botellonesDevueltos).to.equal(3);
  });

  test("el cliente queda inactivo", function() {
    expect(res.getBody().activo).to.equal(false);
  });
}

