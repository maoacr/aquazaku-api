meta {
  name: Crear usuario
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/users
  body: json
}

body:json {
  {
    "email": "{{emailNuevo}}",
    "name": "Usuario de Bruno",
    "password": "contrasena-de-prueba-123",
    "roles": ["pos"]
  }
}

docs {
  Alta de usuario. El email se genera en cada corrida para que la colección se
  pueda correr muchas veces sin chocar con el 409 de email repetido.

  Nace con mustChangePassword: la contraseña la eligió un admin, así que la
  persona la cambia al entrar (spec §7.2).
}

script:pre-request {
  bru.setVar("emailNuevo", `bruno-${Date.now()}@aquazaku.com`);
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("usuarioCreadoId", res.getBody().id);
  }
}

tests {
  test("responde 201", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("devuelve el usuario con sus roles", function() {
    expect(res.getBody().roles).to.eql(["pos"]);
  });

  test("nace obligado a cambiar la contraseña", function() {
    expect(res.getBody().mustChangePassword).to.equal(true);
  });
}
