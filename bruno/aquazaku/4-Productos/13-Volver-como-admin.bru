meta {
  name: Volver a la sesion de admin
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/api/auth/sign-in/email
  body: json
}

body:json {
  {
    "email": "{{adminEmail}}",
    "password": "{{adminPassword}}"
  }
}

docs {
  Restituye la sesión de admin.

  Sin esto, la carpeta 5-Sesion cerraría la sesión del pos en vez de la del
  admin, y su verificación de "la credencial deja de servir" probaría otra cosa
  de la que dice probar.
}

tests {
  test("responde 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
